{
    "note": "Binds :k:psi to the unshaded kotlin-compiler (com.intellij.* not relocated), as detekt 2.0 requires. Sibling kc binds the shaded kotlin-compiler-embeddable, as ktlint requires.",
    "type": "BasicJvmOnlyMod",
    "dependencies": [
        {
            "type": "Projects",
            "cfg": "api",
            "paths": [
                ":k:model",
                ":k:psi"
            ]
        },
        {
            "type": "Projects",
            "cfg": "implementation",
            "paths": [
                ":k:file"
            ]
        },
        {
            "type": "Lib",
            "cfg": "compileOnly",
            "key": "kotlin-compiler"
        },
        {
            "type": "Projects",
            "cfg": "testImplementation",
            "paths": [
                ":k:test"
            ]
        }
    ]
}
